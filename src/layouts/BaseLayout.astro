---
import '../styles/global.css';
import '../styles/additions.css';
import { SITE, absoluteUrl } from '../data/site.js';
import { TOOL_LIST, CATEGORY_LIST } from '../data/tools.js';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const { title, description, path, ogType = 'website', jsonLd = [], robots } = Astro.props;
const canonical = absoluteUrl(path);
const robotsContent = robots ?? (SITE.indexable ? 'index,follow,max-image-preview:large' : 'noindex,nofollow');
const searchIndex = [
  ...TOOL_LIST.map((t) => ({ title: t.title, kind: 'Calculadora', url: t.path, terms: t.search })),
  ...CATEGORY_LIST.map((c) => ({ title: c.title, kind: 'Categoría', url: c.path, terms: c.title + ' ' + c.short })),
];
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#087a72" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {jsonLd.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header currentPath={path} />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    {!SITE.indexable && <div class="status"><b>●</b> {SITE.devLabel}</div>}
    <script is:inline id="search-index" type="application/json" set:html={JSON.stringify(searchIndex)} />
    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
