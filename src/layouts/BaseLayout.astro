---
import '../styles/site.css';
import { SITE } from '../data/site.js';
import { headModel } from '../i18n/seo.js';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentSlot from '../components/ConsentSlot.astro';

// Props: ctx (contexto del idioma, ver src/lib/context.js), pageKey (clave en la tabla de rutas; null fuera de ella),
// path (solo si pageKey es null), title, description, ogType, jsonLd, robots.
const { ctx, pageKey = null, path, title, description, ogType = 'website', jsonLd = [], robots } = Astro.props;
const head = headModel({ locale: ctx.locale, key: pageKey, path, siteUrl: SITE.url, indexable: SITE.indexable, robots });
const { ui } = ctx;
---
<!doctype html>
<html lang={head.lang} dir={head.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="google-site-verification" content="ryTMVfyc4RxAKIpxqKYdcivaRMRdP7ZirevoOgV83c0" />
    <ConsentSlot />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={head.robots} />
    <link rel="canonical" href={head.canonical} />
    {head.alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0c1b2e" />
    <meta property="og:site_name" content={ui.site.name} />
    <meta property="og:locale" content={head.ogLocale} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={head.canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {jsonLd.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#contenido">{ui.a11y.skip}</a>
    <Header ctx={ctx} currentKey={pageKey} />
    <main id="contenido">
      <slot />
    </main>
    <Footer ctx={ctx} />
    <script is:inline id="search-index" type="application/json" set:html={JSON.stringify(ctx.searchIndex)} />
    <script is:inline id="page-i18n" type="application/json" set:html={JSON.stringify({ open: ui.a11y.openMenu, close: ui.a11y.closeMenu, empty: ui.search.empty, noResults: ui.toolsHub.noResults })} />
    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
