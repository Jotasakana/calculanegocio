---
import { CONSENT } from '../data/consent.js';
import { PAGE_IDS } from '../i18n/publish.js';
const { ctx } = Astro.props;
const { ui } = ctx;
---
<footer class="footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a class="foot-brand" href={ctx.path('home')}>Calcula<span>Negocio</span></a>
        <p>{ui.footer.blurb}</p>
      </div>
      <div>
        <strong>{ui.footer.calculators}</strong>
        {ctx.tools.map((t) => <a href={t.path}>{t.menuTitle}</a>)}
      </div>
      <div>
        <strong>{ui.footer.explore}</strong>
        <a href={ctx.path('tools')}>{ui.footer.allTools}</a>
        {ctx.categories.map((c) => <a href={c.path}>{c.title}</a>)}
      </div>
      <div>
        <strong>{ui.footer.info}</strong>
        <a href={ctx.path('methodology')}>{ui.footer.methodology}</a>
        {PAGE_IDS.map((id) => <a href={ctx.path('page:' + id)}>{ui.legalPages[id].footerLabel}</a>)}
        {CONSENT.enabled && <button type="button" class="footer-link" data-cmp-open>{ui.footer.cookieSettings}</button>}
      </div>
    </div>
    <div class="footer-bottom">
      <span>{ui.footer.copyright}</span>
      <span>{ui.footer.market}</span>
    </div>
  </div>
</footer>
