---
import { PAGES, CATEGORY_LIST, TOOL_LIST } from '../data/tools.js';
---
<footer class="footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a class="foot-brand" href="/">Calcula<span>Negocio</span></a>
        <p>Herramientas gratuitas para entender los números de tu negocio.</p>
        <small>Proyecto en desarrollo</small>
      </div>
      <div>
        <strong>Calculadoras</strong>
        {TOOL_LIST.map((t) => <a href={t.path}>{t.menuTitle}</a>)}
      </div>
      <div>
        <strong>Explorar</strong>
        <a href={PAGES.tools.path}>Todas las calculadoras</a>
        {CATEGORY_LIST.map((c) => <a href={c.path}>{c.title}</a>)}
      </div>
      <div>
        <strong>Información</strong>
        <a href={PAGES.methodology.path}>Metodología y alcance</a>
        <span class="footer-soon">Contacto · antes del lanzamiento</span>
        <span class="footer-soon">Privacidad · pendiente</span>
        <span class="footer-soon">Aviso legal · pendiente</span>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© 2026 CalculaNegocio</span>
      <span>Diseñado para España</span>
    </div>
  </div>
</footer>
