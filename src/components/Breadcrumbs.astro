---
// items: [{ label, href? }]; el último es la página actual (sin enlace).
const { items, label } = Astro.props;
---
<nav class="crumb" aria-label={label}>
  <ol>
    {items.map((it, i) => (
      <li>{it.href && i < items.length - 1 ? <a href={it.href}>{it.label}</a> : <span aria-current="page">{it.label}</span>}</li>
    ))}
  </ol>
</nav>
