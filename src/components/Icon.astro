---
// Icono decorativo (24×24, solo línea). El nombre accesible de cada control va siempre en el texto, nunca en el icono.
import { ICON_PATHS } from '../lib/icons.js';

const { name, class: className } = Astro.props;
const d = ICON_PATHS[name];
if (!d) throw new Error(`Icono desconocido: ${name}`);
---
<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={d} /></svg>
