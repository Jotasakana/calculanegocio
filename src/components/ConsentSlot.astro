---
import { CONSENT } from '../data/consent.js';
// Solo cargar la etiqueta de AdSense cuando la CMP de Google ya esté publicada
// y se hayan actualizado los textos legales. En el resto de situaciones:
// metaetiqueta y ads.txt son suficientes para la verificación.
const active = CONSENT.enabled && CONSENT.provider === 'google-adsense';
---
{active && <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${CONSENT.publisherId}`} crossorigin="anonymous"></script>}
