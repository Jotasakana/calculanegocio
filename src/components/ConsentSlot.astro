---
// Etiqueta AdSense de la cuenta actual. Solo se carga tras verificar y configurar
// consentimiento de esta cuenta en AdSense y activar la bandera de despliegue.
// La verificación del sitio utiliza la metaetiqueta de BaseLayout y public/ads.txt.
import { CONSENT } from '../data/consent.js';
const adsEnabled = import.meta.env.PUBLIC_ADSENSE_READY === 'true';
const cmpConfigured = CONSENT.enabled && typeof CONSENT.scriptUrl === 'string' && /^https:\/\//.test(CONSENT.scriptUrl);
---
{cmpConfigured && <script is:inline src={CONSENT.scriptUrl}></script>}
{adsEnabled && cmpConfigured && <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3562913599767371" crossorigin="anonymous"></script>}
