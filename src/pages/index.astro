---
// "/" redirige TEMPORALMENTE a /es/ mientras solo esté publicado el español (decisión aprobada).
// La redirección real (302) la aplica public/_redirects en Cloudflare Pages; esta página es el respaldo
// para cualquier otro servidor y para vistas previas locales. No se redirige por el idioma del navegador.
// Cuando haya varios idiomas publicados se sustituirá por una página de elección de idioma (sin redirección automática).
import { DEFAULT_LOCALE } from '../i18n/locales.js';
import { pathFor } from '../i18n/routes.js';
import { buildContext } from '../lib/context.js';
import { SITE } from '../data/site.js';

const ctx = buildContext(DEFAULT_LOCALE);
const target = pathFor(DEFAULT_LOCALE, 'home');
---
<!doctype html>
<html lang={ctx.loc.hreflang} dir={ctx.loc.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{ctx.ui.site.name}</title>
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={SITE.url + target} />
    <meta name="robots" content="noindex,follow" />
  </head>
  <body>
    <p><a href={target}>{ctx.ui.redirect.text}</a></p>
  </body>
</html>
