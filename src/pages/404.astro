---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PAGES } from '../data/tools.js';
---
<BaseLayout
  title="Página no encontrada | CalculaNegocio"
  description="La página que buscas no existe o ha cambiado de dirección."
  path="/404/"
  robots="noindex,follow"
>
  <div class="wrap notfound">
    <span class="kicker">ERROR 404</span>
    <h1>Esta página no existe</h1>
    <p>Puede que la dirección haya cambiado o que el enlace no sea correcto. Prueba con alguna de nuestras calculadoras.</p>
    <div class="actions" style="justify-content:center">
      <a class="cta" href={PAGES.tools.path}>Ver calculadoras</a>
      <a class="outline" href="/" style="text-decoration:none">Ir al inicio</a>
    </div>
  </div>
</BaseLayout>
