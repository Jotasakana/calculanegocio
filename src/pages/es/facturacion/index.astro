---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ToolTile from '../../../components/ToolTile.astro';
import { TOOLS, CATEGORIES, PAGES } from '../../../data/tools.js';
import { breadcrumbLd } from '../../../lib/jsonld.js';

const cat = CATEGORIES.facturacion;
const crumbs = [
  { label: 'Inicio', href: PAGES.home.path, path: PAGES.home.path },
  { label: cat.title, path: cat.path },
];
---
<BaseLayout
  title="Facturación: base imponible e IVA | CalculaNegocio"
  description="Herramientas de facturación: calcula la base imponible, añade o quita IVA y desglosa una factura con varias líneas."
  path={cat.path}
  jsonLd={[breadcrumbLd(crumbs)]}
>
  <div class="wrap">
    <Breadcrumbs items={crumbs} />
    <div class="pagehead">
      <span class="kicker">CATEGORÍA</span>
      <h1>Facturación</h1>
      <p>{cat.description}</p>
    </div>
    <div class="grid tools-v3 tools-1">
      {cat.tools.map((id) => <ToolTile tool={TOOLS[id]} />)}
    </div>
    <article class="content">
      <h2 class="sec" style="margin-top:0">Qué puedes hacer en esta categoría</h2>
      <p>La <a href={TOOLS.iva.path}>{TOOLS.iva.title}</a> permite añadir IVA a una base imponible, quitar el IVA a un total para obtener la base y desglosar una factura con varias líneas y distintos tipos de IVA.</p>
      <p>La herramienta hace operaciones aritméticas con los datos y los tipos que introduces. No determina qué tipo de IVA corresponde a una operación: para eso, consulta la información oficial de la Agencia Tributaria o a tu asesoría.</p>
      <p>Si lo que quieres es fijar un precio y ver el efecto del IVA sobre el precio final, usa la <a href={TOOLS.precio.path}>{TOOLS.precio.title}</a>, dentro de <a href={CATEGORIES['margenes-y-precios'].path}>{CATEGORIES['margenes-y-precios'].title}</a>.</p>
    </article>
  </div>
</BaseLayout>
