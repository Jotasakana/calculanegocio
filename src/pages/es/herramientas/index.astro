---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ToolTile from '../../../components/ToolTile.astro';
import { TOOLS, CATEGORY_LIST, PAGES } from '../../../data/tools.js';
import { breadcrumbLd } from '../../../lib/jsonld.js';

const crumbs = [
  { label: 'Inicio', href: PAGES.home.path, path: PAGES.home.path },
  { label: 'Calculadoras', path: PAGES.tools.path },
];
---
<BaseLayout
  title="Calculadoras gratuitas para autónomos | CalculaNegocio"
  description="Todas las calculadoras de CalculaNegocio: margen comercial, precio de venta, margen bruto y neto, y base imponible e IVA. Gratis y sin registro."
  path={PAGES.tools.path}
  jsonLd={[breadcrumbLd(crumbs)]}
>
  <div class="wrap">
    <Breadcrumbs items={crumbs} />
    <div class="pagehead">
      <span class="kicker">CALCULADORAS GRATUITAS</span>
      <h1>Calculadoras para autónomos y pequeños negocios</h1>
      <p>Herramientas para calcular márgenes, precios, rentabilidad y el IVA de tus facturas. Cada una explica su fórmula e incluye ejemplos resueltos.</p>
    </div>
    {CATEGORY_LIST.map((c) => (
      <section style="margin-bottom:40px" aria-labelledby={`cat-${c.id}`}>
        <h2 id={`cat-${c.id}`} style="margin:0 0 6px"><a href={c.path} style="color:inherit;text-decoration:none">{c.title}</a></h2>
        <p class="muted" style="margin:0 0 18px">{c.short}.</p>
        <div class={`grid tools-v3 tools-${c.tools.length === 1 ? '1' : '3'}`}>
          {c.tools.map((id) => <ToolTile tool={TOOLS[id]} />)}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
