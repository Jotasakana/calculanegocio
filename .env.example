# Dominio canónico (por defecto: https://calculanegocio.com)
SITE_URL=https://calculanegocio.com
# SITE_INDEXABLE: SOLO para entornos locales o previews. Con el valor exacto "false" todo es noindex y robots.txt
# lleva Disallow. Si la variable no existe (o vale otra cosa), el sitio es INDEXABLE: 84 páginas index,follow y las 30
# legales noindex. NO copiar esta línea al entorno de producción de Cloudflare Pages.
SITE_INDEXABLE=false
